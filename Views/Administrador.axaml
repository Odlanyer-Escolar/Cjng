<ContentPage xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cjng.Administrador"
        >
    
                   <StackPanel>
                                       <TextBlock Foreground="Black" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,30">EMPLEADOS</TextBlock>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            
                                            <Label Content="Nombre " Margin="0,5,0,0" FontSize="20" FontWeight="Bold"/>
                                            <TextBox Width="200"></TextBox>

                                        </StackPanel>
                     
                                        <StackPanel Margin="0,10,0,10" Orientation="Horizontal" HorizontalAlignment="Center">

                                            <Label Content="Puesto   " FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBox Width="200"/>

                                        </StackPanel>
                      
                                        <StackPanel Margin="" Orientation="Horizontal" HorizontalAlignment="Center">
                                            
                                            <Label Content="Salario   " FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBox Width="200"/>
                                        
                                        </StackPanel>
                                        
                                        <Button Content="AGREGAR" FontSize="20" FontWeight="Bold" Margin="0,10,0,0" Background="LimeGreen" Foreground="White" CornerRadius="20" Width="140" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" />
                                        
                                        <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                                            <Label Content="Seleccionar empleado existente"/>
                                            <ComboBox Width="200" HorizontalAlignment="Left" Margin="8,0,0,0"></ComboBox>
                                        </StackPanel>
                       <Button Content="EDITAR" VerticalContentAlignment="Bottom" HorizontalAlignment="Center" Margin="0,10,0,0" Background="LimeGreen" Foreground="White" CornerRadius="20" Width="100" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                   </StackPanel>
</ContentPage>
