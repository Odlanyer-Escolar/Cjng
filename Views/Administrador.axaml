<ContentPage xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Cjng.Administrador"
		Background="#F5F5F5">
	<Grid RowDefinitions="Auto,*,Auto">
		<!-- Header -->
		<Border Grid.Row="0" Background="Crimson" Padding="20">
			<StackPanel>
				<TextBlock Text="ADMINISTRACIÓN DE EMPLEADOS" FontSize="28" FontWeight="Bold" Foreground="White"/>
				<TextBlock Text="Gestiona la información completa de empleados del sistema" FontSize="12" Foreground="LightPink" Margin="0,5,0,0"/>
			</StackPanel>
		</Border>

		<!-- Contenido Principal -->
		<ScrollViewer Grid.Row="1" Margin="20">
			<StackPanel Spacing="15">
				<!-- Sección: Agregar Nuevo Empleado -->
				<Border Background="White" Padding="20" CornerRadius="8">
					<StackPanel>
						<TextBlock Text="AGREGAR NUEVO EMPLEADO" FontSize="18" FontWeight="Bold" Foreground="Crimson" Margin="0,0,0,15"/>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="👤 Nombre del Empleado:" FontSize="13" FontWeight="Bold"/>
							<TextBox x:Name="txtNombreNuevo" Height="35" Margin="0,5,0,0"/>
						</StackPanel>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="💼 Cargo/Puesto:" FontSize="13" FontWeight="Bold"/>
							<TextBox x:Name="txtCargoNuevo" Height="35" Margin="0,5,0,0"/>
						</StackPanel>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="💰 Salario Mensual ($):" FontSize="13" FontWeight="Bold"/>
							<TextBox x:Name="txtSalarioNuevo" Height="35" Margin="0,5,0,0"/>
						</StackPanel>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="📊 Estado:" FontSize="13" FontWeight="Bold"/>
							<ComboBox x:Name="cmbEstadoNuevo" Height="35" Margin="0,5,0,0">
								<ComboBoxItem>Activo</ComboBoxItem>
								<ComboBoxItem>Inactivo</ComboBoxItem>
							</ComboBox>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,20,0,0">
							<Button x:Name="btnAgregarEmpleado" Click="btnAgregarEmpleado_Click" Background="LimeGreen" Foreground="White" Padding="20,12">
								✓ AGREGAR
							</Button>
							<Button x:Name="btnLimpiar" Click="btnLimpiar_Click" Background="Orange" Foreground="White" Padding="20,12">
								✕ LIMPIAR
							</Button>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Sección: Editar Empleado -->
				<Border Background="White" Padding="20" CornerRadius="8">
					<StackPanel>
						<TextBlock Text="EDITAR EMPLEADO EXISTENTE" FontSize="18" FontWeight="Bold" Foreground="DarkOrange" Margin="0,0,0,15"/>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="🔍 Seleccionar Empleado:" FontSize="13" FontWeight="Bold"/>
							<ComboBox x:Name="cmbTrabajadores" Height="35" Margin="0,5,0,0"/>
						</StackPanel>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="Nuevo Cargo:" FontSize="13" FontWeight="Bold"/>
							<TextBox x:Name="txtCargoEditar" Height="35" Margin="0,5,0,0"/>
						</StackPanel>

						<StackPanel Margin="0,10,0,10">
							<TextBlock Text="Nuevo Salario:" FontSize="13" FontWeight="Bold"/>
							<TextBox x:Name="txtSalarioEditar" Height="35" Margin="0,5,0,0"/>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,20,0,0">
							<Button x:Name="btnEditar" Click="btnEditar_Click" Background="Orange" Foreground="White" Padding="20,12">
								✎ EDITAR
							</Button>
							<Button x:Name="btnEliminar" Click="btnEliminar_Click" Background="Crimson" Foreground="White" Padding="20,12">
								🗑 ELIMINAR
							</Button>
						</StackPanel>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- Footer -->
		<Border Grid.Row="2" Background="WhiteSmoke" Padding="20">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="btnVolver" Click="btnVolver_Click" Background="Gray" Foreground="White" Padding="15,10">
					← VOLVER
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</ContentPage>
