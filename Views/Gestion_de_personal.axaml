<ContentPage xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	x:Class="Cjng.Gestion_de_personal"
	Background="#F5F5F5">
	<Grid RowDefinitions="Auto,*,Auto">
		<!-- Header -->
		<Border Grid.Row="0" Background="SteelBlue" Padding="20">
			<StackPanel>
				<TextBlock Text="GESTIÓN DE PERSONAL" FontSize="28" FontWeight="Bold" Foreground="White"/>
				<TextBlock Text="Administra y visualiza información de todos los trabajadores" FontSize="12" Foreground="LightGray" Margin="0,5,0,0"/>
			</StackPanel>
		</Border>

		<!-- Contenido Principal -->
		<Grid Grid.Row="1" ColumnDefinitions="1.5*,*" Margin="20">
			<!-- Listado de Trabajadores -->
			<StackPanel Grid.Column="0">
				<!-- Barra de Búsqueda -->
				<Border Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,15">
					<StackPanel>
						<TextBlock Text="FILTROS Y BÚSQUEDA" FontSize="16" FontWeight="Bold" Foreground="SteelBlue" Margin="0,0,0,10"/>
						<StackPanel Orientation="Horizontal" Spacing="10">
							<StackPanel Width="250">
								<TextBlock Text="🔍 Buscar por nombre:" FontSize="12" FontWeight="Bold"/>
								<TextBox x:Name="txtBuscar" Height="35" Margin="0,5,0,0"/>
							</StackPanel>
							<StackPanel Width="150">
								<TextBlock Text="Estado:" FontSize="12" FontWeight="Bold"/>
								<ComboBox x:Name="cmbEstado" Height="35" Margin="0,5,0,0">
									<ComboBoxItem>Todos</ComboBoxItem>
									<ComboBoxItem>Activos</ComboBoxItem>
									<ComboBoxItem>Inactivos</ComboBoxItem>
								</ComboBox>
							</StackPanel>
							<Button x:Name="btnBuscar" Click="btnBuscar_Click" Background="SteelBlue" Foreground="White" Padding="20,10" VerticalAlignment="Bottom">
								🔍 BUSCAR
							</Button>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Listado de Trabajadores -->
				<ListBox x:Name="lstTrabajadores" Height="350" SelectionChanged="lstTrabajadores_SelectionChanged"/>
			</StackPanel>

			<!-- Información del Empleado Seleccionado -->
			<Border Grid.Column="1" Background="White" Padding="20" CornerRadius="8" Margin="15,0,0,0">
				<ScrollViewer>
					<StackPanel x:Name="stkDetalles">
						<TextBlock Text="INFORMACIÓN DEL EMPLEADO" FontSize="16" FontWeight="Bold" Foreground="SteelBlue" Margin="0,0,0,15"/>

						<StackPanel x:Name="stkSinSeleccionar" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
							<TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center"/>
							<TextBlock Text="Selecciona un empleado para ver sus detalles" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Gray"/>
						</StackPanel>

						<StackPanel x:Name="stkConDetalles" IsVisible="False" Spacing="15">
							<StackPanel>
								<TextBlock Text="Nombre:" FontSize="12" FontWeight="Bold" Foreground="SteelBlue"/>
								<TextBlock x:Name="lblNombre" Text="" FontSize="14" Margin="0,5,0,0"/>
							</StackPanel>

							<StackPanel>
								<TextBlock Text="ID:" FontSize="12" FontWeight="Bold" Foreground="SteelBlue"/>
								<TextBlock x:Name="lblId" Text="" FontSize="14" Margin="0,5,0,0"/>
							</StackPanel>

							<StackPanel>
								<TextBlock Text="Cargo:" FontSize="12" FontWeight="Bold" Foreground="SteelBlue"/>
								<TextBlock x:Name="lblCargo" Text="" FontSize="14" Margin="0,5,0,0"/>
							</StackPanel>

							<StackPanel>
								<TextBlock Text="Salario Mensual:" FontSize="12" FontWeight="Bold" Foreground="SteelBlue"/>
								<TextBlock x:Name="lblSalario" Text="" FontSize="14" Margin="0,5,0,0" Foreground="Green" FontWeight="Bold"/>
							</StackPanel>

							<StackPanel>
								<TextBlock Text="Fecha de Registro:" FontSize="12" FontWeight="Bold" Foreground="SteelBlue"/>
								<TextBlock x:Name="lblFechaRegistro" Text="" FontSize="14" Margin="0,5,0,0"/>
							</StackPanel>

							<StackPanel>
								<TextBlock Text="Estado:" FontSize="12" FontWeight="Bold" Foreground="SteelBlue"/>
								<TextBlock x:Name="lblEstado" Text="" FontSize="14" Margin="0,5,0,0" FontWeight="Bold"/>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- Footer -->
		<Border Grid.Row="2" Background="WhiteSmoke" Padding="20">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="btnVolver" Click="btnVolver_Click" Background="Gray" Foreground="White" Padding="15,10">
					← VOLVER
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</ContentPage>
