<ContentPage xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cjng.Menu"
       >
                        <StackPanel>
                            <Button Content="Gestión de personal" x:Name="BotonGestion" Click="BotonGestion_Click"/>
                            <Button Content="Administrador" x:Name="BotonAdministrador" Click="BotonAdministrador_Click"/>
                            <Button Content="Control de accesos" x:Name="BotonControl" Click="BotonControl_Click"/>
                            <Button Content="Reportes" x:Name="BotonReportes" Click="BotonReportes_Click"/>
                        </StackPanel>
</ContentPage>
